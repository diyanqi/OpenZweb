      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer “Skip future SMS verification”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认勾选「跳过以后的短信验证」"
          }
        },
        "zh-Hant": {
