    },
    "settings.show_dock_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the main window hides the Dock icon and keeps OpenZweb running in the menu bar. Quit only from the tray menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭主窗口后程序坞图标会隐藏，应用继续在菜单栏托盘运行。请从托盘菜单选择退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉主視窗後程式塢圖示會隱藏，應用繼續在選單列托盤執行。請從托盤選單選擇結束。"
          }
        }
      }
