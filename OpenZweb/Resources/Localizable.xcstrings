          }
        }
      }
    },
    "settings.prefer_skip_sms_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults to checked on secondary SMS (submit with $ prefix, like EZ4Connect). Effectiveness depends on aTrust policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二次短信时默认勾选跳过（提交加 $ 前缀，同 EZ4Connect）。是否生效取决于 aTrust 策略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
