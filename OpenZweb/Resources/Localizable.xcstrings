    "sms.skip_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as EZ4Connect: prefix $ to request skipping later secondary SMS. Server policy may deny it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 EZ4Connect 相同：验证码前加 $，请求跳过后续二次短信。服务端不一定允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 EZ4Connect 相同：驗證碼前加 $，請求略過後續二次簡訊。伺服器不一定允許。"
          }
        }
      }
    },
    "sms.reenter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The field will shake on error; re-enter the 6-digit code and submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入框会抖动提示错误，请重新输入 6 位验证码后提交"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入框會抖動提示錯誤，請重新輸入 6 位驗證碼後提交"
          }
        }
      }
    },
    "proxy.conflict_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close system proxy first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先关闭系统代理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先關閉系統代理"
          }
        }
      }
    },
    "proxy.conflict_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A system proxy is enabled (HTTP / HTTPS / SOCKS or auto-proxy). Turn all proxy switches off in System Settings → Network → Details → Proxies, then connect again.\n(If this is a leftover OpenZweb local proxy, tap “Connect Anyway”; OpenZweb will take over again after a successful connect.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到系统代理已开启（HTTP / HTTPS / SOCKS 或自动代理）。请到「系统设置 → 网络 → 详细信息 → 代理」关闭全部开关后再连接。\n（若是 OpenZweb 上次连接留下的本机代理，可点「仍然连接」；连接成功后会重新接管。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到系統代理已開啟（HTTP / HTTPS / SOCKS 或自動代理）。請到「系統設定 → 網路 → 詳細資訊 → 代理」關閉全部開關後再連線。\n（若是 OpenZweb 上次連線留下的本機代理，可點「仍然連線」；連線成功後會重新接管。）"
          }
        }
      }
    },
    "proxy.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recheck"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
