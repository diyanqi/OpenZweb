    "routing.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowlist is written to the engine; denylist goes to system proxy bypass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白名单写入引擎；黑名单写入系统代理绕过列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白名單寫入引擎；黑名單寫入系統代理繞過清單"
          }
        }
      }
    },
    "routing.allow_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowlist (force VPN)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白名单（强制代理）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白名單（強制代理）"
          }
        }
      }
    },
    "routing.allow_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow list: only these domains use OpenZweb (PAC). Leave empty to send all traffic through the system proxy. One domain per line; *.example.com is OK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白名单：仅这些域名走 OpenZweb（PAC 分流）。留空则全部流量走系统代理。每行一个域名；支持 *.example.com。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白名單：僅這些網域走 OpenZweb（PAC 分流）。留空則全部流量走系統代理。每行一個網域；支援 *.example.com。"
          }
        }
      }
    },
    "routing.allow_example": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g.\n*.zju.edu.cn\nwww.cc98.org\nscholar.edu.cn\ngithub.com"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：\n*.zju.edu.cn\nwww.cc98.org\nscholar.edu.cn\ngithub.com"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：\n*.zju.edu.cn\nwww.cc98.org\nscholar.edu.cn\ngithub.com"
          }
        }
      }
    },
    "routing.deny_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denylist (bypass)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑名单（直连绕过）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黑名單（直連繞過）"
          }
        }
      }
    },
    "routing.deny_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deny list: always DIRECT (system proxy bypass / PAC). Useful for local LAN and tools that must not use the VPN proxy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑名单：始终直连（系统代理绕过 / PAC）。适合本机、局域网或不想走 VPN 的工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黑名單：始終直連（系統代理繞過 / PAC）。適合本機、區域網或不想走 VPN 的工具。"
          }
        }
      }
    },
    "routing.deny_example": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: localhost, music.163.com — only applies when “Set system proxy” is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例：localhost, music.163.com — 仅在开启「自动设置系统代理」时生效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例：localhost, music.163.com — 僅在開啟「自動設定系統代理」時生效"
          }
        }
      }
    },
    "routing.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: with an allow list, only listed hosts hit OpenZweb — ideal for coexisting with other proxies. Empty allow list = global proxy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：填写白名单后，只有名单内域名进入 OpenZweb，便于与其他代理共存。白名单为空 = 全局系统代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：填寫白名單後，只有名單內網域進入 OpenZweb，便於與其他代理共存。白名單為空 = 全域系統代理。"
          }
        }
      }
    },
