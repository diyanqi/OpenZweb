    "cas.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: this only opens the web page; a successful login here does not auto-connect VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明：此处仅打开网页，登录成功后不会自动连 VPN。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明：此處僅開啟網頁，登入成功後不會自動連 VPN。"
          }
        }
      }
    },
    "cas.howto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To connect with unified auth: on the main screen choose “CAS (Unified Auth)”, then Connect; the engine handles the CAS flow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要用统一身份认证连内网：在主界面认证方式选「统一身份认证 (CAS)」，再点「连接内网」，由协议引擎完成 CAS 流程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要用統一身分認證連內網：在主介面認證方式選「統一身分認證 (CAS)」，再點「連線內網」，由協定引擎完成 CAS 流程。"
          }
        }
      }
    },
    "sms.skip_secondary_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You still enter the code this time. With this checked, a \"$\" prefix asks the server to skip secondary SMS next time (EZ4Connect). Server may refuse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次仍须输入验证码。勾选后提交时会加 $ 前缀，请求服务器下次跳过二次短信（与 EZ4Connect 相同）。服务端可能拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次仍須輸入驗證碼。勾選後提交時會加 $ 前綴，請求伺服器下次略過二次簡訊（與 EZ4Connect 相同）。伺服器可能拒絕。"
          }
        }
      }
    },
    "settings.show_dock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Dock when window is open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
