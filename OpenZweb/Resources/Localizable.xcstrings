    "settings.manage_proxy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set system proxy after connect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后自动设置系统代理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線後自動設定系統代理"
          }
        }
      }
    },
    "settings.manage_proxy_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will own system HTTP/SOCKS proxy. If Clash etc. is on, disable its system proxy first, or turn this off to coexist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会占用系统 HTTP/SOCKS 代理。若已开 Clash 等，请先关闭其系统代理，或关闭本选项以共存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會佔用系統 HTTP/SOCKS 代理。若已開 Clash 等，請先關閉其系統代理，或關閉本選項以共存。"
          }
        }
      }
    },
    "settings.manage_proxy_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not change system proxy; can coexist with Clash. Point campus domains to local SOCKS (default 127.0.0.1:1080) and set vpn.zju.edu.cn to DIRECT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不修改系统代理，可与 Clash 等共存。请在 Clash 将 *.zju.edu.cn / cc98.org 等校内域名指向本机 SOCKS（默认 127.0.0.1:1080），并为 vpn.zju.edu.cn 设置直连。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不修改系統代理，可與 Clash 等共存。請在 Clash 將 *.zju.edu.cn / cc98.org 等校內網域指向本機 SOCKS（預設 127.0.0.1:1080），並為 vpn.zju.edu.cn 設定直連。"
          }
        }
      }
    },
    "settings.auto_reconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto reconnect on drop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
